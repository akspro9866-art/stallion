{
  "private": true,
  "name": "cavalry-bridge",
  "displayName": "Stallion",
  "description": "Scripting bridge for Cavalry",
  "version": "0.11.0",
  "license": "MIT",
  "publisher": "Scenery",
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/akspro9866-art/stallion.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "title": "Send To Cavalry",
        "command": "stallion.post",
        "enablement": "activeEditor"
      },
      {
        "title": "Send To Cavalry As…",
        "command": "stallion.postas",
        "enablement": "activeEditor"
      },
      {
        "title": "Insert Cavalry Types",
        "command": "stallion.insert",
        "enablement": "activeEditor"
      }
    ]
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development npm run build",
    "build": "node ./scripts/build.mjs",
    "deploy": "cross-env NODE_ENV=production npm run build && node scripts/deploy-cavalry.mjs",
    "sync-mg": "node ./scripts/sync-mg.mjs",
    "vscode:prepublish": "cross-env NODE_ENV=production npm run build",
    "pretest": "cross-env NODE_ENV=production npm run build",
    "test": "npm run lint && npm run test:protocol && npm run test:mock",
    "test:protocol": "node test/protocol/bridge-protocol.mjs && node --test test/protocol/batch-eval-and-capture.test.mjs test/protocol/batch-checkpoint-rollback.test.mjs",
    "test:mock": "node test/run.mjs",
    "test:ci": "cross-env NODE_ENV=production npm run build && npm run typecheck && npm run lint && npm run test:protocol && npm run test:mock && node .github/scripts/skill-parity.mjs",
    "test:live": "node scripts/live-preflight.mjs",
    "typecheck": "tsc --noEmit",
    "test:vscode": "node ./test/vscode/runTest.js",
    "lint": "eslint ."
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 4,
    "semi": false,
    "singleQuote": true,
    "useTabs": true,
    "bracketSpacing": true,
    "arrowParens": "always"
  },
  "dependencies": {
    "@scenery/cavalry-types": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.0.3",
    "@types/vscode": "^1.145.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "glob": "^13.0.0",
    "globals": "^16.5.0",
    "mocha": "^11.7.5",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
